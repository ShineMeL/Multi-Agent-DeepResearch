# Copy this file to .env.demo in the project/worktree you launch.
# Keep real keys server-local. Never commit or paste them into chat.
MODEL_PROVIDER=kimi-instant
MODEL_BASE_URL=https://api.moonshot.cn/v1
MODEL_ID=kimi-k2.6
MODEL_API_KEY=
# Tavily is the search provider. A Kimi key does not authorize Tavily.
SEARCH_API_KEY=
# Aliases accepted: MOONSHOT_API_KEY / KIMI_API_KEY and TAVILY_API_KEY.
# Local live demos use bounded tokens/search/time; monetary cost is UNKNOWN.
# They may incur charges. This launcher is not a public-production deployment.
