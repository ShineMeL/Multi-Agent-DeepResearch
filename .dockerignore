.git
.github
.superpowers
.worktrees

# Local Python environments and generated caches can occur below any source tree.
**/.venv
**/venv
**/.cache
**/.mypy_cache
**/.pytest_cache
**/.ruff_cache
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd

# Keep local configuration and credential material out of the build context.
**/.env
**/.env.*
**/.aws
**/.ssh
**/.config/gcloud
**/credentials.json
**/*credentials*.json
**/*.key
**/*.pem
**/*.p12
**/*.pfx

# Runtime state belongs in named volumes, never in an image layer.
**/artifacts
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log

experiments/*/
benchmarks/private/
benchmarks/snapshots/external/
